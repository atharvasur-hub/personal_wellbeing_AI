# ============================================================
# GOOGLE GEMINI API KEY  ← PASTE YOUR KEY HERE
# Get it FREE at: https://aistudio.google.com/app/apikey
# ============================================================
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ============================================================
# SUPABASE DATABASE  ← PASTE YOUR SUPABASE CREDENTIALS HERE
# Get them from: https://supabase.com/dashboard → Settings → API
# ============================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ============================================================
# LOCAL OLLAMA (OPTIONAL - only if you have Ollama installed)
# ============================================================
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1
VITE_OLLAMA_MODEL=llama3
